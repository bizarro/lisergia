{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lisergia-studio",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "studio.lisergia.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
