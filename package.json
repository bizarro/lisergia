{
  "name": "lisergia",
  "private": true,
  "scripts": {
    "build": "bun --env-file=.env run turbo run build",
    "check-types": "turbo run check-types",
    "deploy:studio": "bun --env-file=.env run --cwd apps/backend deploy:cloudflare",
    "deploy:web": "bun --env-file=.env run --cwd apps/frontend deploy",
    "dev": "bun --env-file=.env run turbo run dev",
    "lint": "turbo run lint",
    "lint:all": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
