# Workers Static Assets headers. Only applies to files served from `build/`,
# not to pages rendered by the Worker.

# Hashed by Vite (entry, chunks and CSS): a new deploy means a new filename.
/bundle-*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, so cache for a week and revalidate in the background after that.
# The sprite is only versioned when `ASSET_VERSION` is set, so it can't be immutable.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/bundle.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
