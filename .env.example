# Sanity (required)
SANITY_API=2023-05-03
SANITY_DATABASE=production
SANITY_PROJECT=your-project-id

# Sanity visual editing and draft previews (optional)
# Generate a Viewer token at https://www.sanity.io/manage and keep it server-only.
# SANITY_API_READ_TOKEN=sk-your-viewer-token
# SANITY_STUDIO_URL=http://localhost:3000
# SANITY_STUDIO_PREVIEW_URL=http://localhost:8787

# Analytics and fonts (optional)
# POSTHOG_KEY=phc_your-project-token
# POSTHOG_HOST=https://us.i.posthog.com
# TYPEKIT=your-adobe-fonts-kit-id

# Klaviyo newsletter signup (optional)
# KLAVIYO_API_KEY=pk_your-private-api-key
# KLAVIYO_LIST_ID=your-list-id

# Local asset development (optional; defaults shown)
# VITE_PORT=5173
# VITE_ORIGIN=http://localhost:5173

# Production asset cache busting (optional)
# ASSET_VERSION=your-release-id
