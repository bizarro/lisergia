{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lisergia",
  "main": "worker.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build",
    "run_worker_first": ["/signup"]
  },
  "vars": {
    "SANITY_API": "2023-05-03",
    "SANITY_DATABASE": "production",
    "SANITY_PROJECT": "lqn1inyo",
    "SANITY_STUDIO_URL": "https://studio.lisergia.dev"
  },
  "routes": [
    {
      "pattern": "lisergia.dev",
      "custom_domain": true
    }
  ],
  "dev": {
    "port": 8787
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
