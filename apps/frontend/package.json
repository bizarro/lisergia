{
  "name": "lisergia-frontend",
  "private": true,
  "version": "21.0.0",
  "scripts": {
    "content": "bun download.ts",
    "dev": "concurrently --kill-others \"bun run dev:client\" \"bun run dev:server\"",
    "dev:server": "bun --watch index.ts",
    "dev:client": "lisergia dev",
    "build": "bun run build:server && bun run build:client",
    "build:server": "bun build ./index.ts --outfile index.js --target=node",
    "build:client": "bun run content && lisergia build",
    "postinstall": "bun run build"
  },
  "type": "module",
  "dependencies": {
    "@portabletext/to-html": "^2.0.14",
    "@sanity/asset-utils": "^2.2.1",
    "@sanity/client": "^6.29.1",
    "animejs": "^4.0.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.9.0",
    "express": "^5.1.0",
    "gsap": "^3.13.0",
    "staticify": "^5.0.0",
    "stylelint": "^16.19.1",
    "twig": "^1.17.1",
    "ua-parser-js": "^2.0.3"
  },
  "devDependencies": {
    "@lisergia/cli": "21.0.0",
    "@lisergia/config-eslint": "21.0.0",
    "@lisergia/config-stylelint": "21.0.0",
    "@lisergia/config-tsconfig": "21.0.0",
    "@lisergia/core": "21.0.0",
    "@lisergia/managers": "21.0.0",
    "@lisergia/styles": "21.0.0",
    "@lisergia/utilities": "21.0.0",
    "@types/express": "^5.0.1",
    "@types/express-serve-static-core": "^5.0.6",
    "concurrently": "^9.1.2",
    "eslint-config-prettier": "^8.6.0",
    "mobx": "^6.13.7",
    "prettier": "^3.0.2",
    "typescript": "^5.1.6"
  }
}
